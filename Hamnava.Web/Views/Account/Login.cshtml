@model LoginOtpViewModel

<section class="hn-section">
    <div class="hn-container" style="max-width:460px;">
        <div class="hn-card">
            <div style="text-align:center;margin-bottom:1.25rem;">
                <img src="/img/logo.webp" alt="هم‌نوا" style="width:68px;height:68px;border-radius:50%;margin:0 auto 0.65rem;" />
                <h1 style="margin:0 0 0.3rem;font-size:1.4rem;color:var(--hn-espresso);">ورود / ثبت‌نام در پنل هم‌نوا</h1>
                <p style="margin:0;color:var(--hn-text-muted);font-size:0.88rem;">
                    @(Model.IsDevelopmentSmsMode
                        ? "حالت توسعه فعال است — ورود و ثبت‌نام مستقیم با شماره موبایل بدون کد تایید"
                        : "شماره موبایل خود را وارد کنید؛ در صورت جدید بودن شماره، به مرحله تکمیل ثبت‌نام هدایت می‌شوید.")
                </p>
            </div>

            <form asp-action="Login" method="post" class="hn-form-grid">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="ReferralCode" />
                <div asp-validation-summary="ModelOnly" class="hn-validation-summary"></div>

                <div class="hn-field">
                    <label asp-for="MobileNumber">شماره موبایل</label>
                    <input asp-for="MobileNumber" class="hn-input" dir="ltr" placeholder="09123456789" required autofocus />
                    <span asp-validation-for="MobileNumber" style="color:var(--hn-danger);font-size:0.8rem;"></span>
                </div>

                <button type="submit" class="hn-btn hn-btn-espresso">
                    @(Model.IsDevelopmentSmsMode ? "ورود / ادامه ثبت‌نام" : "ارسال کد تایید ۴ رقمی")
                </button>
            </form>
        </div>
    </div>
</section>
