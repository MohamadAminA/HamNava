@{
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var canonicalUrl = $"{baseUrl}/";
    var pageTitle = "آموزشگاه موسیقی هم نوا اصفهان | یادگیری رایگان اولین قطعه با تضمین بازگشت وجه";
    var pageDescription = "آموزشگاه موسیقی هم نوا اصفهان: آموزش پیانو، گیتار، ویولن و ارگ. اولین قطعه را کاملاً رایگان یاد بگیرید. تضمین بازگشت شهریه و پنل اختصاصی والدین و هنرجو.";
    var pageKeywords = "آموزش موسیقی اصفهان, آموزشگاه موسیقی اصفهان, کلاس پیانو اصفهان, آموزش گیتار اصفهان, آموزش ویولن اصفهار, آموزش آنلاین موسیقی, کلاس خصوصی موسیقی اصفهان, آموزش موسیقی کودکان اصفهان, آموزش ارگ اصفهان, بهترین آموزشگاه موسیقی اصفهان";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription">
    <meta name="keywords" content="@pageKeywords">
    <meta name="author" content="آموزشگاه موسیقی هم نوا">
    <meta name="language" content="fa">
    <meta name="geo.region" content="IR-03">
    <meta name="geo.placename" content="Isfahan">
    <meta name="geo.position" content="32.6546;51.6680">
    <meta name="ICBM" content="32.6546, 51.6680">
    <meta name="theme-color" content="#1b1a17">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="هم نوا">
    <meta property="og:title" content="@pageTitle">
    <meta property="og:description" content="@pageDescription">
    <meta property="og:image" content="@($"{baseUrl}/assets/img/logo.webp")">
    <meta property="og:url" content="@canonicalUrl">
    <meta property="og:locale" content="fa_IR">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@pageTitle">
    <meta name="twitter:description" content="@pageDescription">
    <meta name="twitter:image" content="@($"{baseUrl}/assets/img/logo.webp")">
    <link rel="preload" href="assets/fonts/vazirmatn/Vazirmatn-RD-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="assets/fonts/vazirmatn/Vazirmatn-RD-Medium.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="assets/fonts/vazirmatn/Vazirmatn-RD-Bold.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="assets/css/templatemo-606-string-master.css">
    <base href="/" />
    <link href="assets/img/favicon.ico" rel="icon">
    <link href="assets/img/favicon.ico" rel="apple-touch-icon">
    <link rel="canonical" href="@canonicalUrl">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="googlebot" content="index, follow">

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "MusicSchool",
      "name": "آموزشگاه موسیقی هم نوا",
      "alternateName": ["Ham Nava", "همنوا"],
      "url": "@canonicalUrl",
      "image": "@($"{baseUrl}/assets/img/logo.webp")",
      "description": "@pageDescription",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "دروازه دولت، چهارباغ پایین، جنب هتل پیروزی، واحد ۴",
        "addressLocality": "اصفهان",
        "addressCountry": "IR"
      },
      "geo": { "@@type": "GeoCoordinates", "latitude": 32.6546, "longitude": 51.6680 },
      "telephone": "+989013348988",
      "email": "a.aghakabiri@gmail.com",
      "priceRange": "$$",
      "areaServed": "Isfahan",
      "sameAs": ["https://eitaa.com/maminma", "https://ble.ir/maminma"],
      "hasOfferCatalog": {
        "@@type": "OfferCatalog",
        "name": "دوره‌های آموزشی موسیقی",
        "itemListElement": [
          { "@@type": "Offer", "itemOffered": { "@@type": "Course", "name": "آموزش پیانو اصفهان" } },
          { "@@type": "Offer", "itemOffered": { "@@type": "Course", "name": "آموزش گیتار اصفهان" } },
          { "@@type": "Offer", "itemOffered": { "@@type": "Course", "name": "آموزش ویولن اصفهان" } }
        ]
      }
    }
    </script>
</head>

<body class="rtl">

<!-- ─── CONTACT MODAL ─── -->
<div class="modal-overlay" id="contactModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-box">
        <button class="modal-close" id="modalClose" aria-label="بستن">✕</button>
        <div class="modal-title" id="modalTitle">رزرو جلسه رایگان</div>
        <div class="modal-subtitle">اطلاعات خود را وارد کنید — ظرف ۲۴ ساعت با شما تماس می‌گیریم.</div>
        <form class="modal-form" id="contactForm" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" id="cf-subject" name="Subject" value="رزرو جلسه رایگان">

            <div class="modal-field" data-field="Name">
                <label for="cf-name">نام شما *</label>
                <input type="text" id="cf-name" name="Name" placeholder="مثلاً علی احمدی" maxlength="200">
                <div class="field-error">نام الزامی است</div>
            </div>

            <div class="modal-field" data-field="Phone">
                <label for="cf-phone">شماره تماس *</label>
                <input type="tel" id="cf-phone" name="Phone" placeholder="۰۹۱۲۳۴۵۶۷۸۹" maxlength="14" inputmode="numeric">
                <div class="field-error">شماره تماس معتبر نیست (مثال: ۰۹۱۲۳۴۵۶۷۸۹)</div>
            </div>

            <div class="modal-field">
                <label for="cf-instrument">ساز مورد نظر</label>
                <select id="cf-instrument" name="Instrument">
                    <option value="">انتخاب کنید (اختیاری)</option>
                    <option>پیانو</option>
                    <option>گیتار آکوستیک</option>
                    <option>گیتار الکتریک</option>
                    <option>گیتار نایلون</option>
                    <option>گیتار بیس</option>
                    <option>ویولن</option>
                    <option>ارگ</option>
                    <option>ملودیکا</option>
                    <option>بلز</option>
                    <option>کالیمبا</option>
                    <option>مطمئن نیستم</option>
                </select>
            </div>

            <div class="modal-field" data-field="Message">
                <label for="cf-message">توضیحات (سن، سطح، هدف)</label>
                <textarea id="cf-message" name="Message" maxlength="2000" placeholder="مثلاً: برای فرزند ۸ ساله‌ام دنبال پیانو هستم، مبتدی کامل..."></textarea>
                <div class="field-error">توضیحات نباید بیشتر از ۲۰۰۰ کاراکتر باشد</div>
            </div>

            <div id="modalMsg" class="modal-msg" role="alert" aria-live="polite"></div>
            <button type="submit" class="modal-submit" id="modalSubmit">ارسال و رزرو جلسه</button>
        </form>
        <div class="modal-note">
            یا مستقیم تماس بگیرید:
            <a href="tel:09013348988">۰۹۰۱۳۳۴۸۹۸۸</a> ·
            <a href="https://ble.ir/maminma" target="_blank" rel="noopener" class="social-link-bale">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="11" fill="#1AA1DC"/>
                    <path d="M17.6 7.2 6.9 11.4c-.7.3-.7.7 0 1l2.7.9 1 3.3c.1.4.5.5.8.2l1.5-1.4 2.6 1.9c.5.4 1 .1 1.1-.4L18 7.8c.1-.5-.2-.8-.4-.6Z" fill="#fff"/>
                </svg>
                بله
            </a> ·
            <a href="https://eitaa.com/maminma" target="_blank" rel="noopener" class="social-link-eitaa">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="11" fill="#149945"/>
                    <path d="M17.6 7.2 6.9 11.4c-.7.3-.7.7 0 1l2.7.9 1 3.3c.1.4.5.5.8.2l1.5-1.4 2.6 1.9c.5.4 1 .1 1.1-.4L18 7.8c.1-.5-.2-.8-.4-.6Z" fill="#fff"/>
                </svg>
                ایتا
            </a>
        </div>
    </div>
</div>

