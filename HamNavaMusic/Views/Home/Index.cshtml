@{
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var canonicalUrl = $"{baseUrl}/";
    var pageTitle = "آموزشگاه موسیقی هم نوا اصفهان | پیانو، گیتار، ویولن، کلاس خصوصی و آنلاین";
    var pageDescription = "آموزشگاه موسیقی هم نوا در اصفهان با تضمین یادگیری و بازگشت وجه. کلاس‌های خصوصی پیانو، گیتار، ویولن، ارگ. مشاوره و استعدادیابی رایگان. اولین قطعه را رایگان یاد بگیرید.";
    var pageKeywords = "آموزش موسیقی اصفهان, آموزشگاه موسیقی اصفهان, هم نوا, آموزش پیانو اصفهان, آموزش گیتار اصفهان, آموزش ویولن اصفهان, کلاس خصوصی موسیقی اصفهان, کلاس آنلاین موسیقی, تضمین یادگیری موسیقی, آموزش موسیقی کودکان, آموزش موسیقی بزرگسالان, استعدادیابی موسیقی, مشاوره موسیقی رایگان, شهریه کلاس موسیقی";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription">
    <meta name="keywords" content="@pageKeywords">
    <meta name="author" content="آموزشگاه موسیقی هم نوا">
    <meta name="language" content="fa">
    <meta name="geo.region" content="IR-03">
    <meta name="geo.placename" content="Isfahan">
    <meta name="geo.position" content="32.6546;51.6680">
    <meta name="ICBM" content="32.6546, 51.6680">
    <meta name="theme-color" content="#1b1a17">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="هم نوا">
    <meta property="og:title" content="@pageTitle">
    <meta property="og:description" content="@pageDescription">
    <meta property="og:image" content="@($"{baseUrl}/assets/img/logo.webp")">
    <meta property="og:url" content="@canonicalUrl">
    <meta property="og:locale" content="fa_IR">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@pageTitle">
    <meta name="twitter:description" content="@pageDescription">
    <meta name="twitter:image" content="@($"{baseUrl}/assets/img/logo.webp")">
