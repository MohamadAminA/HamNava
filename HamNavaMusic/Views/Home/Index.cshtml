<script src="assets/js/templatemo-606-string-scripts.js" defer></script>

<script>
(function () {
    /* ── Floating support toggle ── */
    const supportBtn = document.getElementById('supportToggle');
    const supportMenu = document.getElementById('supportMenu');
    const supportRoot = document.getElementById('floatingSupport');
    if (supportBtn) {
        supportBtn.addEventListener('click', function () {
            const isHidden = supportMenu.getAttribute('aria-hidden') === 'true';
            supportMenu.setAttribute('aria-hidden', isHidden ? 'false' : 'true');
            supportRoot.classList.toggle('open', isHidden);
        });
    }

    /* ── Modal logic ── */
    const modal      = document.getElementById('contactModal');
    const closeBtn   = document.getElementById('modalClose');
    const form       = document.getElementById('contactForm');
    const submitBtn  = document.getElementById('modalSubmit');
    const msgEl      = document.getElementById('modalMsg');
    const modalTitle = document.getElementById('modalTitle');
    const subjectField = document.getElementById('cf-subject');

    function clearErrors() {
        form.querySelectorAll('.modal-field.has-error').forEach(function (f) {
            f.classList.remove('has-error');
        });
        msgEl.className = 'modal-msg';
        msgEl.textContent = '';
    }

    function setFieldError(fieldName, text) {
        const field = form.querySelector('.modal-field[data-field="' + fieldName + '"]');
        if (!field) return;
        field.classList.add('has-error');
        const errEl = field.querySelector('.field-error');
        if (errEl && text) errEl.textContent = text;
    }

    function openModal(subject) {
        const finalSubject = subject || 'رزرو جلسه رایگان';
        modalTitle.textContent = finalSubject;
        subjectField.value = finalSubject;
        clearErrors();
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
        setTimeout(function () { document.getElementById('cf-name').focus(); }, 100);
    }

    function closeModal() {
        modal.classList.remove('active');
        document.body.style.overflow = '';
    }

    document.querySelectorAll('.open-modal').forEach(function (el) {
        el.addEventListener('click', function () {
            openModal(this.dataset.subject);
        });
    });

    closeBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', function (e) {
        if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal.classList.contains('active')) closeModal();
    });

    // Clear a field's error state as the person types
    ['Name', 'Phone', 'Message'].forEach(function (fieldName) {
        const input = form.querySelector('[name="' + fieldName + '"]');
        if (input) {
            input.addEventListener('input', function () {
                const field = form.querySelector('.modal-field[data-field="' + fieldName + '"]');
                if (field) field.classList.remove('has-error');
            });
        }
    });

    /* ── Client-side validation ── */
    function normalizePhone(value) {
        const persian = '۰۱۲۳۴۵۶۷۸۹';
        const arabic  = '٠١٢٣٤٥٦٧٨٩';
        return value.replace(/[۰-۹٠-٩]/g, function (ch) {
            let idx = persian.indexOf(ch);
            if (idx === -1) idx = arabic.indexOf(ch);
            return idx !== -1 ? String(idx) : ch;
        }).replace(/\s|-/g, '');
    }

    function validateForm() {
        clearErrors();
        let valid = true;

        const name = form.querySelector('[name="Name"]').value.trim();
        if (!name) {
            setFieldError('Name', 'نام الزامی است');
            valid = false;
        } else if (name.length > 200) {
            setFieldError('Name', 'نام نباید بیشتر از ۲۰۰ کاراکتر باشد');
            valid = false;
        }

        const phoneInput = form.querySelector('[name="Phone"]');
        const normalizedPhone = normalizePhone(phoneInput.value.trim());
        if (!normalizedPhone) {
            setFieldError('Phone', 'شماره تماس الزامی است');
            valid = false;
        } else {
            phoneInput.value = normalizedPhone;
        }

        if (!subjectField.value || !subjectField.value.trim()) {
            subjectField.value = 'رزرو جلسه رایگان';
        }

        const message = form.querySelector('[name="Message"]').value;
        if (message.length > 2000) {
            setFieldError('Message', 'توضیحات نباید بیشتر از ۲۰۰۰ کاراکتر باشد');
            valid = false;
        }

        return valid;
    }

    /* ── Form submission ── */
    form.addEventListener('submit', async function (e) {
        e.preventDefault();

        if (!validateForm()) {
            showMsg('لطفاً خطاهای فرم را برطرف کن.', 'error');
            return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'در حال ارسال...';
        msgEl.className = 'modal-msg';
        msgEl.textContent = '';

        try {
            const formData = new FormData(form);
            const resp = await fetch('/Contact/SubmitForm', {
                method: 'POST',
                body: formData
            });
            const data = await resp.json();
            if (data.success) {
                showMsg('✓ پیام شما ارسال شد. به‌زودی با شما تماس می‌گیریم.', 'success');
                form.reset();
                setTimeout(closeModal, 3000);
            } else {
                showMsg(data.message || 'خطا در ارسال. لطفاً دوباره تلاش کنید.', 'error');
            }
        } catch (err) {
            showMsg('مشکل در اتصال. لطفاً با تلفن تماس بگیرید.', 'error');
        } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = 'ارسال و رزرو جلسه';
        }
    });

    function showMsg(text, type) {
        msgEl.textContent = text;
        msgEl.className = 'modal-msg ' + type;
    }

    /* ── FAQ Accordion ── */
    document.querySelectorAll('.faq-trigger').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const item = this.closest('.faq-item');
            const isOpen = item.classList.contains('open');
            // close others
            document.querySelectorAll('.faq-item.open').forEach(openItem => {
                if (openItem !== item) openItem.classList.remove('open');
            });
            if (!isOpen) item.classList.add('open');
            else item.classList.remove('open');
        });
    });

})();
</script>

