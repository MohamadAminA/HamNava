    <!-- Trust Section -->
    <section class="trust" id="about">
        <div class="section-container trust-grid">
            <div class="trust-content">
                <div class="section-header align-start">
                    <div class="section-label">درباره هم نوا</div>
                    <h2 class="section-title">آکادمی خصوصی برای رشد هنری و نظم آموزشی</h2>
                    <p class="section-description">
                        در هم نوا, مسیر یادگیری هر هنرجو با توجه به سطح, هدف و ساز انتخابی طراحی می شود.
                        از اولین جلسه تا اجرای صحنه, همه چیز با برنامه و همراهی دقیق مدرسین پیش می رود.
                    </p>
                </div>
                <ul class="trust-list">
                    <li>مدیریت هنرجویان با ثبت سطح, ساز آموزشی و برنامه تمرین</li>
                    <li>رزرو کلاس ها و حضور و غیاب دقیق با اعلان های هوشمند</li>
                    <li>پرداخت شهریه و مدیریت اقساط بدون نیاز به مراجعه حضوری</li>
                    <li>شروع مطمئن با مشاوره تخصصی و استعداد یابی رایگان</li>
                </ul>
                <div class="trust-actions">
                    <a href="#features" class="btn-secondary">آشنایی با خدمات آموزشی</a>
                    <a href="#pricing" class="btn-primary">دریافت مشاوره رایگان</a>
                </div>
                <div class="trust-benefits-strip">
                    <span>تضمین یادگیری تا تسلط کامل</span>
                    <span>بازگشت وجه جلسات باقی‌مانده</span>
                    <span>معرفی دوست = یک ترم رایگان</span>
                    <span>کنسرت آموزشی رایگان دوره‌ای</span>
                </div>
            </div>
            <div class="trust-cards">
                <div class="trust-card">
                    <div class="trust-card-title">کلاس های خصوصی موسیقی</div>
                    <p>هر هنرجو یک مسیر اختصاصی دارد, از انتخاب ساز تا طراحی تمرین های هفتگی.</p>
                    <span class="trust-card-meta">تمرکز بر کیفیت, نه تعداد</span>
                </div>
                <div class="trust-card">
                    <div class="trust-card-title">پنل هنرجو و والدین</div>
                    <p>گزارش پیشرفت, تکالیف هفتگی و سوابق حضور همیشه در دسترس است.</p>
                    <span class="trust-card-meta">شفافیت و پیگیری مداوم</span>
                </div>
                <div class="trust-card">
                    <div class="trust-card-title">پنل مدرسین موسیقی</div>
                    <p>مدرسین می توانند برنامه کلاس, تمرین و ارزیابی را یکپارچه مدیریت کنند.</p>
                    <span class="trust-card-meta">سازگاری با سبک تدریس شما</span>
                </div>
            </div>
        </div>
    </section>

