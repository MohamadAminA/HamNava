[Unit]
Description=Hamnava Music Academy ASP.NET Core 10 Platform (hamnavamusic.ir)
After=network.target mssql-server.service
Wants=network-online.target

[Service]
Type=notify
User=hamnava
Group=hamnava
WorkingDirectory=/opt/hamnava/current
ExecStart=/usr/bin/dotnet /opt/hamnava/current/Hamnava.Web.dll
EnvironmentFile=/etc/hamnava/hamnava.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
SyslogIdentifier=hamnava-web
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hamnava /var/log/hamnava /opt/hamnava/current/logs

[Install]
WantedBy=multi-user.target
