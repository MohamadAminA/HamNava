# ==============================================================================
# HAMNAVA — PRODUCTION & DEVELOPMENT ENVIRONMENT VARIABLES TEMPLATE
# Never commit real credentials or production secrets to Git.
# ==============================================================================

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5050

# SQL Server Connection Strings
ConnectionStrings__DefaultConnection="Server=YOUR_SQL_HOST,1433;Database=HamnavaDb;User Id=hamnava_app;Password=CHANGE_ME_STRONG_PASSWORD;TrustServerCertificate=False;Encrypt=True;MultipleActiveResultSets=False;"
ConnectionStrings__HangfireConnection="Server=YOUR_SQL_HOST,1433;Database=HamnavaDb;User Id=hamnava_app;Password=CHANGE_ME_STRONG_PASSWORD;TrustServerCertificate=False;Encrypt=True;"

# Application Public URLs & Timezone
Hamnava__SiteBaseUrl="https://hamnavamusic.ir"
Hamnava__TimeZoneId="Asia/Tehran"
Hamnava__InitialAdminMobile="09130000000"
Hamnava__InitialAdminFirstName="مدیر"
Hamnava__InitialAdminLastName="سیستم"

# Zarinpal Payment Gateway (API v4)
PaymentGateway__Zarinpal__Environment="Sandbox"
PaymentGateway__Zarinpal__MerchantId="00000000-0000-0000-0000-000000000000"
PaymentGateway__Zarinpal__CallbackBaseUrl="https://hamnavamusic.ir"
PaymentGateway__Zarinpal__TimeoutSeconds="30"

# ApiPayamak REST v3 SMS Provider
SmsProvider__ApiPayamak__Mode="ApiPayamakV3"
SmsProvider__ApiPayamak__BaseUrl="https://api-payamak.com/api/v3/rest/"
SmsProvider__ApiPayamak__ApiToken="CHANGE_ME_SMS_API_TOKEN"
SmsProvider__ApiPayamak__SenderNumber="CHANGE_ME_SENDER_LINE"
SmsProvider__ApiPayamak__MessageType="0"
SmsProvider__ApiPayamak__TimeoutSeconds="15"

# Media Storage & FFmpeg
MediaStorage__RootPath="/var/lib/hamnava/media"
MediaStorage__TempPath="/var/lib/hamnava/temp"
MediaStorage__FfmpegExecutablePath="/usr/bin/ffmpeg"
MediaStorage__FfprobeExecutablePath="/usr/bin/ffprobe"

# Security & Data Protection
Security__OtpHashPepper="CHANGE_ME_64_CHAR_RANDOM_PEPPER"
Security__DataProtectionKeyRingPath="/var/lib/hamnava/dataprotection-keys"
